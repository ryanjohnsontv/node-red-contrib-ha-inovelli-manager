{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2019"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "rootDir": "src",
    "outDir": "."
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
