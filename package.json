{
  "name": "node-red-contrib-ha-inovelli-manager",
  "version": "1.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryanjohnsontv/node-red-contrib-ha-inovelli-manager.git"
  },
  "bugs": {
    "url": "https://github.com/ryanjohnsontv/node-red-contrib-ha-inovelli-manager/issues"
  },
  "homepage": "https://github.com/ryanjohnsontv/node-red-contrib-ha-inovelli-manager#readme",
  "description": "Nodes for easily managing scenes, parameters, and notifications of Inovelli Red Series (Z-Wave JS), Blue Series (Zigbee2MQTT), and White Series (Matter) switches paired through Home Assistant",
  "keywords": [
    "inovelli",
    "node-red",
    "home assistant",
    "zwave-js",
    "z-wave",
    "zigbee",
    "zigbee2mqtt",
    "matter",
    "notification",
    "scene control"
  ],
  "files": [
    "nodes/**/*.js",
    "nodes/**/*.html",
    "nodes/**/*.svg",
    "examples/**",
    "multicast/**",
    "CHANGELOG.md"
  ],
  "node-red": {
    "nodes": {
      "inovelli-notification-manager": "nodes/notification-manager.js",
      "inovelli-led-manager": "nodes/led-manager.js",
      "inovelli-scene-manager": "nodes/scene-manager.js",
      "inovelli-config-manager": "nodes/config-manager.js"
    },
    "plugins": {
      "inovelli-targets-editor": "nodes/shared/targets-editor.html"
    }
  },
  "author": "Ryan Johnson",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "mocha \"test/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/color-convert": "^2.0.4",
    "@types/mocha": "^10.0.6",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "mocha": "^10.8.2",
    "node-red": "^5.0.4",
    "node-red-node-test-helper": "^0.3.4",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "color-convert": "^2.0.1"
  }
}
